        };

        // te + ,
        combo_less_than {
            bindings = <&kp LS(COMMA)>;
            key-positions = <32 40>;
            timeout-ms = <68>;
            require-prior-idle-ms = <35>;
        };

        // te + .
        combo_greater_than {
            bindings = <&kp LS(DOT)>;
            key-positions = <33 40>;
            timeout-ms = <68>;
            require-prior-idle-ms = <35>;
        };

        // te + /
        combo_question {
            bindings = <&kp LS(FSLH)>;
            key-positions = <34 40>;
            timeout-ms = <68>;
            require-prior-idle-ms = <35>;
        };

        // te + backslash
        combo_pipe {
            bindings = <&kp LS(BSLH)>;
            key-positions = <11 40>;
            timeout-ms = <80>;
            require-prior-idle-ms = <35>;
        };

        // ; + '
        combo_quote_right {
            bindings = <&kp LS(SQT)>;
            key-positions = <22 23>;
            timeout-ms = <68>;
            require-prior-idle-ms = <35>;
        };

        // l + '
        combo_grave_right {
            bindings = <&kp GRAVE>;
            key-positions = <21 23>;
            timeout-ms = <68>;
            require-prior-idle-ms = <35>;
        };

        // // ls + ta
        // combo_alt_ctrl {
        //     bindings = <&kp LC(LALT)>;
        //     key-positions = <24 36>;
        //     timeout-ms = <90>;
        //     require-prior-idle-ms = <50>;
        // };
        //
        // // lc + ta
        // combo_alt_shift {
        //     bindings = <&kp LS(LALT)>;
        //     key-positions = <12 36>;
        //     timeout-ms = <90>;
        //     require-prior-idle-ms = <50>;
        // };
    };

    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LGUI &kp LALT &kp LCTRL &kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release &kp LGUI &kp LALT &kp LCTRL &kp LSHFT>;
        };

        spam_click: spam_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <28>;  // Time between clicks
            tap-ms = <28>;   // Duration of the click down-state
            bindings = 
                <&mkp LCLK>,
                <&mkp LCLK>,
                // <&mkp LCLK>,
                // <&mkp LCLK>,
                <&mkp LCLK>; // Adds a 5-click burst
        };

       mmv_tap_macro: mmv_tap_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = 
                <&macro_param_1to1>,
                <&macro_press &mmv_fast 0>,
                <&macro_wait_time 500>,      // 50ms of instant max speed
                <&macro_param_1to1>,
                <&macro_release &mmv_fast 0>;
        };

        msc_tap_macro: msc_tap_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = 
                <&macro_param_1to1>,
                <&macro_press &msc_fast 0>,
                <&macro_wait_time 500>,      // 50ms of instant max scroll
                <&macro_param_1to1>,
                <&macro_release &msc_fast 0>;
        };
        // prev diagnostic nvim
        lbkt_d: lbkt_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp D>;
        };

        // next diagnostic nvim
        rbkt_d: rbkt_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp D>;
        };

        /* space_p: space_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp P>;
        }; */

        // diagnostic under cursor nvim
        ctrl_w_d: ctrl_w_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(W)>, <&kp D>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "HOME";
            bindings = <
//    ┌──────────────────┬───┬───┬─────────────────┬──────┬─────────────────┐   ┌─────────────────┬───────────────────┬────────────────────┬───┬───┬───┐
//    │ lt_slow FUN tab  │ Q │ W │        E        │  R   │        T        │   │        Y        │         U         │         I          │ O │ P │ \ │
//    ├──────────────────┼───┼───┼─────────────────┼──────┼─────────────────┤   ├─────────────────┼───────────────────┼────────────────────┼───┼───┼───┤
//    │ mt_slow lctl esc │ A │ S │        D        │  F   │        G        │   │        H        │         J         │         K          │ L │ ; │ ' │
//    ├──────────────────┼───┼───┼─────────────────┼──────┼─────────────────┤   ├─────────────────┼───────────────────┼────────────────────┼───┼───┼───┤
//    │       lsft       │ Z │ X │        C        │  V   │        B        │   │        N        │         M         │         ,          │ . │ / │ ` │
//    └──────────────────┴───┴───┼─────────────────┼──────┼─────────────────┤   ├─────────────────┼───────────────────┼────────────────────┼───┴───┴───┘
//                               │ lt_fast NAV del │ lsft │ lt_fast SYM ent │   │ lt_fast NUM spc │ mt_fast lalt bspc │ lt_fast MEDIA lctl │
//                               └─────────────────┴──────┴─────────────────┘   └─────────────────┴───────────────────┴────────────────────┘
  &lt_slow FUN TAB     &kp Q   &kp W   &kp E              &kp R       &kp T                  &kp Y                &kp U                &kp I                  &kp O     &kp P      &kp BSLH
  &mt_slow LCTRL ESC   &kp A   &kp S   &kp D              &kp F       &kp G                  &kp H                &kp J                &kp K                  &kp L     &kp SEMI   &kp SQT
  &kp LSHFT            &kp Z   &kp X   &kp C              &kp V       &kp B                  &kp N                &kp M                &kp COMMA              &kp DOT   &kp FSLH   &kp GRAVE
                                       &lt_fast NAV DEL   &kp LSHFT   &lt_fast SYM RET       &lt_fast NUM SPACE   &mt_fast LALT BSPC   &lt_fast MEDIA LCTRL
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
//    ┌────────────┬──────┬──────┬─────────┬──────┬─────────┐   ┌──────┬──────┬──────┬─────┬────────────┬──────┐
//    │            │      │      │         │      │         │   │ home │ pgdn │ pgup │ end │            │ pscr │
//    ├────────────┼──────┼──────┼─────────┼──────┼─────────┤   ├──────┼──────┼──────┼─────┼────────────┼──────┤
//    │ lctl(lalt) │ lgui │ lalt │  lsft   │ lctl │         │   │      │      │      │     │ lsft(caps) │      │
//    ├────────────┼──────┼──────┼─────────┼──────┼─────────┤   ├──────┼──────┼──────┼─────┼────────────┼──────┤
//    │ lsft(lalt) │      │      │         │      │         │   │ lgui │      │      │     │            │      │
//    └────────────┴──────┴──────┼─────────┼──────┼─────────┤   ├──────┼──────┼──────┼─────┴────────────┴──────┘
//                               │ to BASE │ lalt │ to BASE │   │      │ keyr │ lctl │
//                               └─────────┴──────┴─────────┘   └──────┴──────┴──────┘
  &none          &none      &none      &none       &none       &none          &kp HOME   &kp PG_DN     &kp PG_UP   &kp END   &none          &kp PRINTSCREEN
  &kp LC(LALT)   &kp LGUI   &kp LALT   &kp LSHFT   &kp LCTRL   &none          &trans     &trans        &trans      &trans    &kp LS(CAPS)   &trans
  &kp LS(LALT)   &none      &none      &none       &none       &none          &kp LGUI   &none         &none       &none     &none          &trans
                                       &to BASE    &kp LALT    &to BASE       &trans     &key_repeat   &kp LCTRL
            >;
        };


  //&trans   &kp LS(A)   &kp LS(S)   &kp LS(D)   &kp LS(F)   &kp LS(G)       &kp LS(H)   &kp LS(J)   &kp LS(K)       &kp LS(L)     &mt LGUI SEMI   &kp GRAVE
  //&trans   &kp LS(Z)   &kp LS(X)   &kp LS(C)   &kp LS(V)   &kp LS(B)       &kp LS(N)   &kp LS(M)   &kp LS(COMMA)   &kp LS(DOT)   &kp LS(FSLH)    &trans
        num_layer {
            display-name = "NUM";
            bindings = <
//    ┌─────┬──────┬─────┬─────────┬─────┬─────────┐   ┌──────┬──────┬──────┬──────┬────────────┬─────┐
//    │  1  │  2   │  3  │    4    │  5  │    6    │   │  7   │  8   │  9   │  0   │     -      │  =  │
//    ├─────┼──────┼─────┼─────────┼─────┼─────────┤   ├──────┼──────┼──────┼──────┼────────────┼─────┤
//    │     │ lgui │     │    [    │  ]  │         │   │ left │ down │  up  │ rght │ lsft(caps) │  `  │
//    ├─────┼──────┼─────┼─────────┼─────┼─────────┤   ├──────┼──────┼──────┼──────┼────────────┼─────┤
//    │     │      │     │         │     │         │   │ lgui │  [   │  ]   │      │            │     │
//    └─────┴──────┴─────┼─────────┼─────┼─────────┤   ├──────┼──────┼──────┼──────┴────────────┴─────┘
//                       │ to BASE │     │ mo NSYM │   │      │      │ lctl │
//                       └─────────┴─────┴─────────┘   └──────┴──────┴──────┘
  &kp N1   &kp N2     &kp N3   &kp N4     &kp N5     &kp N6         &kp N7     &kp N8     &kp N9      &kp N0      &kp MINUS      &kp EQUAL
  &trans   &kp LGUI   &trans   &kp LBKT   &kp RBKT   &none          &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT   &kp LS(CAPS)   &kp GRAVE
  &trans   &trans     &trans   &trans     &trans     &trans         &kp LGUI   &kp LBKT   &kp RBKT    &trans      &trans         &trans
                               &to BASE   &trans     &mo NSYM       &trans     &trans     &kp LCTRL
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
//    ┌─────┬──────┬─────┬─────────┬─────────┬─────────┐   ┌─────────────────┬─────────┬─────────┬───────────┬────────────┬─────────┐
//    │  !  │  @   │  #  │    $    │    %    │    ^    │   │        &        │    *    │    (    │     )     │     _      │    +    │
//    ├─────┼──────┼─────┼─────────┼─────────┼─────────┤   ├─────────────────┼─────────┼─────────┼───────────┼────────────┼─────────┤
//    │     │ lgui │     │ lsft([) │ lsft(]) │         │   │      left       │  down   │   up    │   rght    │ lsft(caps) │ lsft(`) │
//    ├─────┼──────┼─────┼─────────┼─────────┼─────────┤   ├─────────────────┼─────────┼─────────┼───────────┼────────────┼─────────┤
//    │     │      │     │         │         │         │   │      lgui       │ &lbkt_d │ &rbkt_d │ &ctrl_w_d │            │         │
//    └─────┴──────┴─────┼─────────┼─────────┼─────────┤   ├─────────────────┼─────────┼─────────┼───────────┴────────────┴─────────┘
//                       │ to BASE │         │ to BASE │   │ lt_fast NUM spc │         │  lctl   │
//                       └─────────┴─────────┴─────────┘   └─────────────────┴─────────┴─────────┘
  &kp EXCL   &kp AT     &kp HASH   &kp DOLLAR     &kp PERCENT    &kp CARET       &kp AMPS             &kp STAR   &kp LPAR    &kp RPAR    &kp UNDERSCORE   &kp PLUS
  &trans     &kp LGUI   &trans     &kp LS(LBKT)   &kp LS(RBKT)   &trans          &kp LEFT             &kp DOWN   &kp UP      &kp RIGHT   &kp LS(CAPS)     &kp LS(GRAVE)
  &trans     &trans     &trans     &trans         &trans         &trans          &kp LGUI             &lbkt_d    &rbkt_d     &ctrl_w_d   &trans           &trans
                                   &to BASE       &trans         &to BASE        &lt_fast NUM SPACE   &trans     &kp LCTRL
            >;
        };

        fun_layer {
            display-name = "F(x)";
            bindings = <
//    ┌─────┬─────┬─────┬─────────┬─────────┬─────────┐   ┌─────────┬──────┬──────┬──────┬──────┬─────┐
//    │ f1  │ f2  │ f3  │   f4    │   f5    │   f6    │   │   f7    │  f8  │  f9  │ f10  │ f11  │ f12 │
//    ├─────┼─────┼─────┼─────────┼─────────┼─────────┤   ├─────────┼──────┼──────┼──────┼──────┼─────┤
//    │     │     │     │ lsft([) │ lsft(]) │         │   │  left   │ down │  up  │ rght │ caps │  `  │
//    ├─────┼─────┼─────┼─────────┼─────────┼─────────┤   ├─────────┼──────┼──────┼──────┼──────┼─────┤
//    │     │     │     │         │         │         │   │  lgui   │      │      │      │      │     │
//    └─────┴─────┴─────┼─────────┼─────────┼─────────┤   ├─────────┼──────┼──────┼──────┴──────┴─────┘
//                      │ to BASE │         │ to BASE │   │ to BASE │      │ lctl │
//                      └─────────┴─────────┴─────────┘   └─────────┴──────┴──────┘
  &kp F1   &kp F2   &kp F3   &kp F4         &kp F5         &kp F6         &kp F7     &kp F8     &kp F9      &kp F10     &kp F11    &kp F12
  &trans   &trans   &trans   &kp LS(LBKT)   &kp LS(RBKT)   &none          &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT   &kp CAPS   &kp GRAVE
  &trans   &trans   &trans   &trans         &trans         &trans         &kp LGUI   &trans     &trans      &trans      &trans     &trans
                             &to BASE       &trans         &to BASE       &to BASE   &trans     &kp LCTRL
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
//    ┌──────────┬──────────┬──────────┬────────────┬────────────┬─────────┐   ┌─────────┬───────────────────┬─────────┬─────────┬────────────────┬───────────┐
//    │ ug_ eff  │          │ ug_ hu-  │  ug_ hu+   │  ug_ sa-   │ ug_ sa+ │   │ ug_ br- │      ug_ br+      │ ug_ sp- │ ug_ sp+ │    ug_ tog     │ out_ tog  │
//    ├──────────┼──────────┼──────────┼────────────┼────────────┼─────────┤   ├─────────┼───────────────────┼─────────┼─────────┼────────────────┼───────────┤
//    │ bt_sel 0 │ bt_sel 1 │ bt_sel 2 │  bt_sel 3  │  bt_sel 4  │ bt_clr  │   │  prev   │ mt_slow mute vold │  volu   │  next   │ &studio_unlock │   bspc    │
//    ├──────────┼──────────┼──────────┼────────────┼────────────┼─────────┤   ├─────────┼───────────────────┼─────────┼─────────┼────────────────┼───────────┤
//    │   app    │   bri-   │   bri+   │ lctl(bri-) │ lctl(bri+) │         │   │   rec   │       stop        │  play   │  mute   │   bt_clr_ALL   │ epwr_ tog │
//    └──────────┴──────────┴──────────┼────────────┼────────────┼─────────┤   ├─────────┼───────────────────┼─────────┼─────────┴────────────────┴───────────┘
//                                     │  to BASE   │            │         │   │ to BASE │                   │  lctl   │
//                                     └────────────┴────────────┴─────────┘   └─────────┴───────────────────┴─────────┘
  &rgb_ug RGB_EFF   &none          &rgb_ug RGB_HUD   &rgb_ug RGB_HUI    &rgb_ug RGB_SAD    &rgb_ug RGB_SAI       &rgb_ug RGB_BRD   &rgb_ug RGB_BRI            &rgb_ug RGB_SPD   &rgb_ug RGB_SPI   &rgb_ug RGB_TOG   &out OUT_TOG
  &bt BT_SEL 0      &bt BT_SEL 1   &bt BT_SEL 2      &bt BT_SEL 3       &bt BT_SEL 4       &bt BT_CLR            &kp C_PREV        &mt_slow C_MUTE C_VOL_DN   &kp C_VOL_UP      &kp C_NEXT        &studio_unlock    &kp BSPC
  &kp K_APP         &kp C_BRI_DN   &kp C_BRI_UP      &kp LC(C_BRI_DN)   &kp LC(C_BRI_UP)   &none                 &kp C_REC         &kp C_STOP                 &kp C_PP          &kp C_MUTE        &bt BT_CLR_ALL    &ext_power EP_TOG
                                                     &to BASE           &trans             &trans                &to BASE          &trans                     &kp LCTRL
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
//    ┌─────┬──────┬──────┬─────────┬──────┬─────────────┐   ┌────────────────┬────────────────┬──────────────┬────────────────┬──────┬─────┐
//    │     │ rclk │ mbck │  mfwd   │ lclk │ &spam_click │   │      lclk      │      mbck      │     mfwd     │      rclk      │ mclk │     │
//    ├─────┼──────┼──────┼─────────┼──────┼─────────────┤   ├────────────────┼────────────────┼──────────────┼────────────────┼──────┼─────┤
//    │     │ lgui │ lalt │  lctl   │ lsft │             │   │ &mmv MOVE_left │ &mmv MOVE_down │ &mmv MOVE_up │ &mmv MOVE_rght │      │     │
//    ├─────┼──────┼──────┼─────────┼──────┼─────────────┤   ├────────────────┼────────────────┼──────────────┼────────────────┼──────┼─────┤
//    │     │      │      │         │      │             │   │ &msc SCRL_left │ &msc SCRL_down │ &msc SCRL_up │ &msc SCRL_rght │      │     │
//    └─────┴──────┴──────┼─────────┼──────┼─────────────┤   ├────────────────┼────────────────┼──────────────┼────────────────┴──────┴─────┘
//                        │ to BASE │      │   to BASE   │   │      lclk      │                │     lctl     │
//                        └─────────┴──────┴─────────────┘   └────────────────┴────────────────┴──────────────┘
  &trans   &mkp RCLK   &mkp MB4   &mkp MB5    &mkp LCLK   &spam_click       &mkp LCLK        &mkp MB4         &mkp MB5       &mkp RCLK         &mkp MCLK   &trans
  &trans   &kp LGUI    &kp LALT   &kp LCTRL   &kp LSHFT   &none             &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &trans      &trans
  &trans   &none       &none      &none       &none       &none             &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP   &msc SCRL_RIGHT   &trans      &trans
                                  &to BASE    &none       &to BASE          &mkp LCLK        &trans           &kp LCTRL
            >;
        };

        num_sym_layer {
            display-name = "NSYM";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │  !  │  @  │  #  │  $  │  %  │  ^  │   │  &  │  *  │  (  │  )  │  -  │  =  │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │   │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │   │     │     │     │     │     │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┘
//                      │     │     │     │   │     │     │     │
//                      └─────┴─────┴─────┘   └─────┴─────┴─────┘
  &kp EXCL   &kp AT   &kp HASH   &kp DLLR   &kp PRCNT   &kp CARET       &kp AMPS   &kp ASTRK   &kp LPAR   &kp RPAR   &kp MINUS   &kp EQUAL
  &trans     &trans   &trans     &trans     &trans      &trans          &trans     &trans      &trans     &trans     &trans      &trans
  &trans     &trans   &trans     &trans     &trans      &trans          &trans     &trans      &trans     &trans     &trans      &trans
                                 &trans     &trans      &trans          &trans     &trans      &trans
            >;
        };
    };
};
