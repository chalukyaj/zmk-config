        //    compatible = "zmk,behavior-hold-tap";
        //    #binding-cells = <2>;
        //    flavor = "tap-preferred";
        //    //flavor = "hold-preferred";
        //    tapping-term-ms = <40>;
        //    //require-prior-idle-ms = <150>;
        //    bindings = <&mo>, <&kp>; // First param = layer, Second param = keycode
        //};

        //mt_tap_hold: mt_tap_hold {
        //    compatible = "zmk,behavior-hold-tap";
        //    #binding-cells = <2>;
        //    flavor = "tap-preferred";
        //    //flavor = "hold-preferred";
        //    tapping-term-ms = <40>;
        //    //require-prior-idle-ms = <150>;
        //    bindings = <&kp>, <&kp>; // First param = layer, Second param = keycode
        //};

        /* 2. Tap Dance:
            1st action (Tap/Hold) -> Space on tap, NUM on hold
            2nd action (Double-Tap) -> Permanently switch layer
        */
        //num_mouse_space: num_mouse_space {
        //    compatible = "zmk,behavior-tap-dance";
        //    #binding-cells = <0>;
        //    tapping-term-ms = <150>;
        //    bindings = <&lt_tap_hold NUM SPACE>, <&to MOUSE>;
        //};

        //num_lock: num_lock {
        //    compatible = "zmk,behavior-tap-dance";
        //    #binding-cells = <0>;
        //    tapping-term-ms = <150>;
        //    bindings = <&lt_tap_hold NUM SPACE>, <&to NUM>;
        //};

        //sft_mouse: sft_mouse {
        //    compatible = "zmk,behavior-tap-dance";
        //    #binding-cells = <0>;
        //    tapping-term-ms = <150>;
        //    bindings = <&mt_tap_hold LSHFT BSPC>, <&to FUN>;
        //};

        //nav_mouse: nav_mouse {
        //    compatible = "zmk,behavior-tap-dance";
        //    #binding-cells = <0>;
        //    tapping-term-ms = <200>;
        //    bindings = <&lt_tap_hold NAV DEL>, <&to MOUSE>;
        //};

        ht_ctrl_tog: hold_ctrl_tap_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            // The first binding is for hold (&kp), the second is for tap (&tog)
            bindings = <&kp>, <&tog>; 
        };

        // 2. DEDICATED FAST NODES FOR TAPS
        // These hit maximum velocity instantly, bypassing the ramp-up.
        mmv_fast: mmv_fast {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <1>;
            acceleration-exponent = <1>;
        };

        msc_fast: msc_fast {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            time-to-max-speed-ms = <1>;
            acceleration-exponent = <1>;
        };

        ht_mmv: ht_mmv {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <130>;
            // Hold uses standard mmv, tap uses the 50ms macro
            bindings = <&mmv>, <&mmv_tap_macro>;
        };

        ht_msc: ht_msc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <130>;
            // Hold uses standard msc, tap uses the 50ms macro
            bindings = <&msc>, <&msc_tap_macro>;
        };
    };
};

